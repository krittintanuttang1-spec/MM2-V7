-- DRAG WINDOW

local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        StartPosition = Main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if Dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local Delta = input.Position - DragStart
        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = false
    end
end)

-- TAB SYSTEM

local CurrentTab

local Window = {}

function Window:CreateTab(Name)
    local Tab = {}

    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, 0, 0, 65)
    TabButton.BackgroundColor3 = Panel
    TabButton.Text = Name
    TabButton.TextColor3 = White
    TabButton.TextSize = 21
    TabButton.Font = Enum.Font.GothamBold
    TabButton.Parent = Sidebar
    Corner(TabButton, 18)

    TabButton.MouseButton1Click:Connect(function()
        if CurrentTab then
            for _, v in ipairs(Content:GetChildren()) do
                if v:IsA("GuiObject") and v ~= ContentLayout
                and v ~= ContentPadding then
                    v.Visible = false
                end
            end
            CurrentTab.BackgroundColor3 = Panel
        end

        CurrentTab = TabButton
        TabButton.BackgroundColor3 = Cyan

        for _, v in ipairs(Content:GetChildren()) do
            if v:IsA("GuiObject") and v ~= ContentLayout
            and v ~= ContentPadding then
                v.Visible = true
            end
        end
    end)

    function Tab:CreateButton(Config)
        local Button = Instance.new("TextButton")
        Button.Size = UDim2.new(1, -8, 0, 65)
        Button.BackgroundColor3 = Panel
        Button.Text = Config.Name
        Button.TextColor3 = White
        Button.TextSize = 20
        Button.Font = Enum.Font.GothamBold
        Button.Parent = Content
        Corner(Button, 18)

        Button.MouseButton1Click:Connect(function()
            if Config.Callback then
                Config.Callback()
            end
        end)

        return Button
    end

    function Tab:CreateToggle(Config)
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, -8, 0, 65)
        Row.BackgroundColor3 = Panel
        Row.Parent = Content
        Corner(Row, 18)

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(0.7, 0, 1, 0)
        Label.Position = UDim2.fromOffset(20, 0)
        Label.BackgroundTransparency = 1
        Label.Text = Config.Name
        Label.TextColor3 = White
        Label.TextSize = 19
        Label.Font = Enum.Font.GothamBold
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Row

        local Toggle = Instance.new("TextButton")
        Toggle.Size = UDim2.fromOffset(95, 42)
        Toggle.Position = UDim2.new(1, -110, 0.5, 0)
        Toggle.AnchorPoint = Vector2.new(0, 0.5)
        Toggle.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        Toggle.Text = ""
        Toggle.Parent = Row
        Corner(Toggle, 25)

        local Dot = Instance.new("Frame")
        Dot.Size = UDim2.fromOffset(30, 30)
        Dot.Position = UDim2.fromOffset(6, 6)
        Dot.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        Dot.Parent = Toggle
        Corner(Dot, 20)

        local State = Config.CurrentValue or false

        local function Update()
            if State then
                Toggle.BackgroundColor3 = Cyan
                Dot.Position = UDim2.new(1, -36, 0, 6)
                Dot.BackgroundColor3 = White
            else
                Toggle.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
                Dot.Position = UDim2.fromOffset(6, 6)
                Dot.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
            end
        end

        Toggle.MouseButton1Click:Connect(function()
            State = not State
            Update()
            if Config.Callback then
                Config.Callback(State)
            end
        end)

        Update()
        return Toggle
    end

    function Tab:CreateSlider(Config)
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, -8, 0, 85)
        Row.BackgroundColor3 = Panel
        Row.Parent = Content
        Corner(Row, 18)

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(0.7, 0, 0, 35)
        Label.Position = UDim2.fromOffset(18, 5)
        Label.BackgroundTransparency = 1
        Label.Text = Config.Name
        Label.TextColor3 = White
        Label.TextSize = 18
        Label.Font = Enum.Font.GothamBold
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Row

        local ValueLabel = Instance.new("TextLabel")
        ValueLabel.Size = UDim2.new(0, 100, 0, 35)
        ValueLabel.Position = UDim2.new(1, -115, 0, 5)
        ValueLabel.BackgroundTransparency = 1
        ValueLabel.TextColor3 = Cyan
        ValueLabel.TextSize = 17
        ValueLabel.Font = Enum.Font.GothamBold
        ValueLabel.Parent = Row

        local Bar = Instance.new("TextButton")
        Bar.Size = UDim2.new(1, -36, 0, 8)
        Bar.Position = UDim2.fromOffset(18, 60)
        Bar.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        Bar.Text = ""
        Bar.Parent = Row
        Corner(Bar, 10)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.fromScale(0, 1)
        Fill.BackgroundColor3 = Cyan
        Fill.Parent = Bar
        Corner(Fill, 10)

        local MinValue = Config.Range[1]
        local MaxValue = Config.Range[2]
        local Value = Config.CurrentValue or MinValue

        local function SetValue(NewValue)
            Value = math.clamp(NewValue, MinValue, MaxValue)
            local Step = Config.Increment or 1
            Value = math.floor(Value / Step + 0.5) * Step
            Value = math.clamp(Value, MinValue, MaxValue)

            local Percent = (Value - MinValue) / (MaxValue - MinValue)
            Fill.Size = UDim2.fromScale(Percent, 1)
            ValueLabel.Text = tostring(Value) .. " " .. (Config.Suffix or "")

            if Config.Callback then
                Config.Callback(Value)
            end
        end

        local function UpdateFromInput(Input)
            local Percent = math.clamp(
                (Input.Position.X - Bar.AbsolutePosition.X)
                / Bar.AbsoluteSize.X, 0, 1
            )
            SetValue(MinValue + (MaxValue - MinValue) * Percent)
        end

        local Sliding = false

        Bar.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
                Sliding = true
                UpdateFromInput(Input)
            end
        end)

        UIS.InputChanged:Connect(function(Input)
            if Sliding and (
                Input.UserInputType == Enum.UserInputType.MouseMovement
                or Input.UserInputType == Enum.UserInputType.Touch
            ) then
                UpdateFromInput(Input)
            end
        end)

        UIS.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
                Sliding = false
            end
        end)

        SetValue(Value)
        return Row
    end

    if not CurrentTab then
        CurrentTab = TabButton
        TabButton.BackgroundColor3 = Cyan
    else
        for _, v in ipairs(Content:GetChildren()) do
            if v:IsA("GuiObject") and v ~= ContentLayout
            and v ~= ContentPadding then
                v.Visible = false
            end
        end
    end

    return Tab
end

